# Database
POSTGRES_DB=lighthouse
POSTGRES_USER=lighthouse
POSTGRES_PASSWORD=changeme_in_production

# Backend
DATABASE_URL=postgresql+asyncpg://lighthouse:changeme_in_production@db:5432/lighthouse
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# CORS (comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Environment
ENVIRONMENT=development

# Demo data — set to true to pre-populate with Savanna Commercial Bank scenario
SEED_DEMO_DATA=false

# ---- Phase 3 plugins (all optional; default to demo mode) ----
# AWS Config / Security Hub — imports compliance findings as risks.
AWS_PLUGIN_ENABLED=true
AWS_REGION=us-east-1
AWS_DEMO_MODE=true            # false → live mode (needs boto3 + AWS credentials)

# MISP threat intelligence — imports events as risks.
MISP_PLUGIN_ENABLED=true
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=true
MISP_DEMO_MODE=true           # false → live mode (needs MISP_URL + MISP_API_KEY)

# Slack — posts notifications to an incoming webhook.
SLACK_PLUGIN_ENABLED=true
SLACK_WEBHOOK_URL=            # empty → demo mode (logs instead of posting)
